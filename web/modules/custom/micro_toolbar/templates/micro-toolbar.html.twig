{# Built-in fallbacks for links without a valid Icon API definition. #}
{% set icons = {
  'system.admin_content': 'M5 3h10l4 4v14H5z M14 3v5h5 M8 12h8 M8 16h8',
  'system.admin_structure': 'M9 3h6v5H9z M3 16h6v5H3z M15 16h6v5h-6z M12 8v4 M6 16v-4h12v4',
  'system.themes_page': 'M12 3a9 9 0 1 0 0 18h1a2 2 0 0 0 0-4h-1a2 2 0 0 1 0-4h4a5 5 0 0 0 0-10z M7 8h.01 M11 6h.01 M16 7h.01 M5 12h.01',
  'system.modules_list': 'M4 4h6v5h4V4h6v6h-5v4h5v6h-6v-5h-4v5H4v-6h5v-4H4z',
  'system.admin_config': 'M4 6h16 M4 12h16 M4 18h16 M8 3v6 M16 9v6 M10 15v6',
  'entity.user.collection': 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0 M17 4a4 4 0 0 1 0 8 M22 21v-2a4 4 0 0 0-3-3.87',
  'system.admin_reports': 'M4 3v18h17 M8 17v-5 M13 17V8 M18 17V4',
  'help.main': 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0 M9 9a3 3 0 0 1 6 0c0 2-3 2-3 4 M12 17h.01'
} %}
{% set fallback = 'M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z' %}
{% macro icon(path) %}
  <svg class="micro-toolbar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="{{ path }}"/></svg>
{% endmacro %}
<nav class="micro-toolbar{{ display_mode == 'icons_only' ? ' micro-toolbar--icons-only' : '' }}" aria-label="Administration">
  <ul class="micro-toolbar__items">
    {% set home_label %}{{ _self.icon('M3 10l9-7 9 7 M5 9v12h5v-7h4v7h5V9') }}<span class="micro-toolbar__label">Home</span>{% endset %}
    <li class="micro-toolbar__item">{{ link(home_label, front_url, {class: ['micro-toolbar__link'], title: 'Home'}) }}</li>
    {% for item in items %}
      {% set label %}
        {% if item.icon %}
          <span class="micro-toolbar__icon" aria-hidden="true">{{ item.icon }}</span>
        {% else %}
          {{ _self.icon(icons[item.original_link.getRouteName()]|default(fallback)) }}
        {% endif %}
        <span class="micro-toolbar__label">{{ item.title }}</span>
      {% endset %}
      <li class="micro-toolbar__item">{{ link(label, item.url, {class: ['micro-toolbar__link'], title: item.title}) }}</li>
    {% endfor %}
  </ul>
  {% set logout_label %}{{ _self.icon('M9 5H4v14h5 M10 12h11 M17 8l4 4-4 4') }}<span class="micro-toolbar__label">Log out</span>{% endset %}
  {{ link(logout_label, logout_url, {class: ['micro-toolbar__link', 'micro-toolbar__logout'], title: 'Log out'}) }}
</nav>
